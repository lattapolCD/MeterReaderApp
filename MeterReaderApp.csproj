<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.8.1" />
    <PackageReference Include="OpenCvSharp4.runtime.osx_arm64" Version="4.8.1" />
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
  </ItemGroup>
  <Target Name="CreateLibsSymlinks" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)../libs" />
    <Exec Command="ln -sf /opt/homebrew/lib/libhdf5.320.dylib $(OutputPath)../libs/libhdf5.310.dylib" />
    <Exec Command="ln -sf /opt/homebrew/lib/libfreetype.6.dylib $(OutputPath)../libs/libfreetype.6.dylib" />
    <Exec Command="ln -sf /opt/homebrew/lib/libharfbuzz.0.dylib $(OutputPath)../libs/libharfbuzz.0.dylib" />
    <Exec Command="ln -sf /opt/homebrew/lib/libdc1394.dylib $(OutputPath)../libs/libdc1394.26.dylib" />
    <Exec Command="ln -sf /opt/homebrew/lib/libsz.dylib $(OutputPath)../libs/libsz.2.0.1.dylib" />
    <Exec Command="ln -sf /opt/homebrew/Cellar/libomp/22.1.7/lib/libomp.dylib $(OutputPath)../libs/libomp.dylib" />
  </Target>
</Project>
